[Unit]
Description=Video Looper - Shuffled fullscreen video playback
After=local-fs.target gpio-init.service
Wants=local-fs.target gpio-init.service

[Service]
Type=simple
User=pi
Group=video
Environment=VIDEO_DIR=/home/pi/videos
ExecStart=/usr/local/bin/video-looper.sh
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# GPU access
SupplementaryGroups=video render

# Hardening
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
